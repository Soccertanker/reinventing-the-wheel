# Cloudflare Pages response headers.
# Vite fingerprints files in /assets (e.g. index-abc123.js), so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must always be revalidated so players pick up new releases.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# The service worker and manifest must be revalidated, or updates get stuck behind the cache.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
